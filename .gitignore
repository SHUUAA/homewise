# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# NOTE: Patterns intentionally have no leading "/" so they match in any
# subfolder (the Next.js app lives in ./homewise, not the repo root).

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/
dist/

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# local tooling (Real-ESRGAN binaries / archives)
_tools/
*.zip

# generated verifier output
homewise/verifier/output/

# local reference material
_reference/
*.mp4
